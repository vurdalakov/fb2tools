<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Analyzers (all projects, see Directory.Build.props)">
    <PackageVersion Include="StyleCop.Analyzers" Version="1.1.118" />
    <PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="10.0.403" />
  </ItemGroup>
  <ItemGroup Label="Fb2Zip">
    <PackageVersion Include="SharpCompress" Version="0.50.8" />
    <PackageVersion Include="System.IO.Hashing" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Label="Fb2Opds">
    <PackageVersion Include="StbImageSharp" Version="2.30.16" />
    <PackageVersion Include="StbImageResizeSharp" Version="0.97.1" />
    <PackageVersion Include="StbImageWriteSharp" Version="1.16.7" />
    <PackageVersion Include="System.CommandLine" Version="2.0.14" />
  </ItemGroup>
</Project>